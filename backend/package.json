{
  "name": "@alephscript/aaia-backend",
  "version": "1.0.0",
  "description": "REST API Gateway for AAIAGallery - connects Angular frontend to MCP AAIA Server",
  "main": "dist/app.js",
  "types": "dist/app.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch & node --watch dist/app.js",
    "start": "node dist/app.js",
    "start:dev": "npx ts-node src/app.ts",
    "clean": "rm -rf dist",
    "test": "jest --forceExit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "socket.io-client": "^4.8.1",
    "uuid": "^9.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "@alephscript/mcp-core-sdk": "file:../../MCPGallery/mcp-core-sdk/alephscript-mcp-core-sdk-1.3.0.tgz"
  }
}
