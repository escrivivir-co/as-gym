{
  "name": "@alephscript/core-browser",
  "version": "1.0.0",
  "description": "Universal browser client for AlephScript - framework agnostic socket.io wrapper",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch",
    "build:dev": "rollup -c --watch",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "pack": "npm run build && npm pack",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "alephscript",
    "socket.io",
    "browser",
    "websocket",
    "real-time",
    "client"
  ],
  "author": "AlephScript Team",
  "license": "MIT",
  "dependencies": {
    "rollup": "^2.79.2",
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "rollup-plugin-terser": "^7.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/escrivivir-co/aleph-script-core-browser"
  },
  "bugs": {
    "url": "https://github.com/escrivivir-co/aleph-script-core-browser/issues"
  },
  "homepage": "https://github.com/escrivivir-co/aleph-script-core-browser#readme"
}
